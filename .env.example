# Binance API Credentials (DO NOT COMMIT REAL KEYS)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Deployment mode: demo never sends orders; live sends real USD-M futures orders.
CRYPTOEA_MODE=demo
BINANCE_EXCHANGE=mainnet

# Required exact value before --mode live is allowed to place production orders.
# CRYPTOEA_LIVE_TRADING_ACK=I_UNDERSTAND_THIS_PLACES_REAL_BINANCE_FUTURES_ORDERS

# SOLUSDT 1h momentum-volume candidate deployment defaults.
CANDIDATE_SUMMARY=research/optimization/vwap_profile_SOLUSDT_1h_20260609_101440/best_summary.json
CANDIDATE_SECTION=best
CRYPTOEA_STATE_DB=runtime/sol_momentum_deploy.sqlite
DEMO_INITIAL_BALANCE=100000
RISK_PER_TRADE=0.01
MAX_POSITION_PCT=1.0
MAX_NOTIONAL_USDT=1000
FEE_RATE=0.0005
SLIPPAGE_RATE=0.001
KLINE_LIMIT=600
POLL_SECONDS=60
SHADOW_POLL_SECONDS=300
SHADOW_OUTPUT_DIR=runtime/shadow_backtest
REPLAY_SOURCE=binance
REPLAY_ENGINE=model
REPLAY_OUTPUT_DIR=runtime/replay_proxy
REPLAY_START=2025-01-01
REPLAY_END=2025-06-01

# Optional warmup/evaluation split for local historical validation replay.
# REPLAY_DATA_START=2020-01-01
# REPLAY_DATA_END=2025-06-01
# REPLAY_EVAL_START=2024-01-01
# REPLAY_EVAL_END=2025-06-01

# Optional: Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Trading Configuration
TRADING_MODE=paper  # paper | live
INITIAL_BALANCE=10000
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_TIMEFRAME=1h
